.{
    .name = .capnpc_zig,
    .version = "0.18.0",
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Pinned to a TAG, not a raw commit: tags are immutable release
        // points, so the pin is auditable and reproducible.
        //
        // v0.24.0 (commit 1d34b32). qmsg still pins v0.21.2; the coordinated
        // release moves it here too, so a process linking both packages can
        // resolve ONE quic module (both parents must also pass the same
        // dependency options). The jump from v0.19.0:
        // 0.21.1 frees the BoringSSL AEAD context leaked per handshake key
        // derivation (~780 KB per handshake; the QUIC heal soak's RSS went
        // 5 MB -> 26.6 GB in 10 minutes on v0.19.0), and 0.24.0 (BREAKING)
        // removes the 4096 lifetime stream cap: `initial_max_streams_*` is
        // now an open-at-once window and `StreamLimitExceeded` is always
        // temporary (see quic/options.zig `defaultTransportParams`).
        // boringssl-zig moves b47af8ce -> ff30fe99 (0.6.7, same BoringSSL
        // source aef0e2df); it still links Windows ws2_32 with pkg-config
        // lookup disabled.
        .quic = .{
            .url = "https://github.com/nullstyle/quic-zig/archive/refs/tags/v0.24.0.tar.gz",
            .hash = "quic-0.24.0-DnSYvUNHNABoGpnSvxo5VEF7RVsZTxddSW3UGp1vCrPw",
            .lazy = true,
        },
    },
    // Only what a downstream consumer needs to build the library + plugin.
    // vendor/ (git submodules that would dangle in a published archive),
    // tests/, bench/, tools/, and examples/ are development-only — the
    // library and plugin never import them at build time.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
        "README.md",
        "LICENSE",
    },
    .fingerprint = 0x9dca32f1156e479d,
}
