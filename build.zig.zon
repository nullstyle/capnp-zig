.{
    .name = .capnpc_zig,
    .version = "0.18.0",
    .minimum_zig_version = "0.17.0-dev.1683",
    .dependencies = .{
        // Pinned to a TAG, not a raw commit: tags are immutable release
        // points, so the pin is auditable and reproducible.
        //
        // v0.19.0 (hash shared with qmsg's pin of the same tarball, so one
        // process can link both packages against one quic). The jump from
        // v0.16.1 crosses three additive releases: 0.17.0 (inbound DATAGRAM
        // overflow sheds instead of closing), 0.18.0 (reuse_port bind
        // options; unused here), and 0.19.0 (handshake-liveness backstop:
        // `handshake_timeout_ms` defaults 30s client / 10s server, new
        // `CloseSource.handshake_timeout` — mapped in
        // quic/close.zig `disconnectCauseFor`; the backstop closes the
        // half-open-slot exhaustion the fanout soak measured on 2026-08-27).
        // boringssl stays b47af8ce under both pins, so the Windows ws2_32
        // linking property carries over unchanged.
        .quic = .{
            .url = "https://github.com/nullstyle/quic-zig/archive/refs/tags/v0.19.0.tar.gz",
            .hash = "quic-0.19.0-DnSYvfDZMADCQvF3_9ZQ75Kwdz3nJ4CBLSwxWizuCsLI",
            .lazy = true,
        },
    },
    // Only what a downstream consumer needs to build the library + plugin.
    // vendor/ (git submodules that would dangle in a published archive),
    // tests/, bench/, tools/, and examples/ are development-only — the
    // library and plugin never import them at build time.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
        "README.md",
        "LICENSE",
    },
    .fingerprint = 0x9dca32f1156e479d,
}
