.{
    .name = .capnpc_zig,
    .version = "0.2.0",
    .minimum_zig_version = "0.17.0-dev.813",
    .dependencies = .{
        .quic_zig = .{
            .url = "https://github.com/nullstyle/quic-zig/archive/0e4d540769890dccc82c4d91d871388b8c3b21b9.tar.gz",
            .hash = "quic_zig-0.2.0-jMbGHSpBMwCOryQ6k65A-A2ymmJqKQWDrJWvL13EpBc7",
            .lazy = true,
        },
    },
    // Only what a downstream consumer needs to build the library + plugin.
    // vendor/ (git submodules that would dangle in a published archive),
    // tests/, bench/, tools/, and examples/ are development-only — the
    // library and plugin never import them at build time.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
    },
    .fingerprint = 0x9dca32f1156e479d,
}
